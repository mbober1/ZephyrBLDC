{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build MicroSpora",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "microspora",
				"${workspaceFolder}/app",
				"-DBOARD_ROOT=${workspaceFolder}",
				"-DDTC_OVERLAY_FILE=${workspaceFolder}/app/boards/microspora.overlay",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Build native",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "native_sim",
				"${workspaceFolder}/app",
				"-DBOARD_ROOT=${workspaceFolder}",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Build devboard",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "weact_stm32g431_core",
				"${workspaceFolder}/app",
				"-DBOARD_ROOT=${workspaceFolder}",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Menuconfig",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-t", "menuconfig"
			],
		},
		{
			"label": "Twister",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"twister",
				"-T", "tests",
				"-p", "native_sim",
				"-v"
			],
		},
		{
			"label": "Build native for clang-tidy",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "native_sim",
				"${workspaceFolder}/app",
				"-d", "${workspaceFolder}/build/native_sim-clang-tidy",
				"-DBOARD_ROOT=${workspaceFolder}",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "clang-tidy native",
			"type": "shell",
			"dependsOn": "Build native for clang-tidy",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/run_clang_tidy.py",
				"${workspaceFolder}/build/native_sim-clang-tidy"
			]
		},
		{
			"label": "Build MicroSpora for clang-tidy",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "microspora",
				"${workspaceFolder}/app",
				"-d", "${workspaceFolder}/build/microspora-clang-tidy",
				"-DBOARD_ROOT=${workspaceFolder}",
				"-DDTC_OVERLAY_FILE=${workspaceFolder}/app/boards/microspora.overlay",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "clang-tidy MicroSpora",
			"type": "shell",
			"dependsOn": "Build MicroSpora for clang-tidy",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/run_clang_tidy.py",
				"${workspaceFolder}/build/microspora-clang-tidy"
			]
		}
	]
}