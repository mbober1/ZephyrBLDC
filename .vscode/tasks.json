{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build MicroSpora",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "microspora",
				"${workspaceFolder}/app",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Build native",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "native_sim",
				"${workspaceFolder}/app",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Build devboard",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p", "auto",
				"-b", "weact_stm32g431_core",
				"${workspaceFolder}/app",
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Menuconfig",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-t", "menuconfig"
			],
		},
		{
			"label": "Twister",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"twister",
				"-T", "tests",
				"-p", "native_sim",
				"-v"
			],
		},
	]
}