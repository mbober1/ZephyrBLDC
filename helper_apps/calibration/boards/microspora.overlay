/ {
	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
	};

	aliases {
		adc0 = &adc1;
		encoder0 = &mt6701;
		motor0 = &svpwm;
		driver0 = &drv8316;
		currsmp0 = &currsmp;
		comm = &usart3;
	};

	feedback: feedback {
		compatible = "spinner,rtio-feedback";
		sensor = <&mt6701>;
		status = "okay";
	};

	motor: motor {
		compatible = "spinner,motor";
		pole-pairs = <11>;
		phase-offset-degrees = <278>;
	};
};

&spi1 {
	dmas = <&dmamux1 0 11 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
	       <&dmamux1 1 10 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";

	mt6701: mt6701@0 {
		compatible = "novosense,mt6701";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(15)>;
		status = "okay";
	};
};

&dma1 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

&spi3 {
	dmas = <&dmamux1 2 15 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
	       <&dmamux1 3 14 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";
	pinctrl-0 = <&spi3_sck_pb3 &spi3_miso_pb4 &spi3_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&gpioc 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";

	drv8316: drv8316@0 {
		compatible = "ti,drv83xx";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(40)>;
		enable-gpios = <&gpiob 7 0>;
		pwm-mode = <0>;
		slew-rate = <3>;
		sdo-mode = <1>;
		csa-gain = <3>;
		pwm-100-duty-frequency = <0>;
		ocp-mode = <0>;
		ocp-level = <0>;
		ocp-retry = <0>;
		ocp-deglitch = <0>;
		recirculation-mode = <0>;
		buck-voltage = <0>;
		buck-current-limit = <0>;
		delay-target = <0>;
		overvoltage-level = <0>;
		overtemperature-report;
		spi-fault-report;
		ocp-cycle-by-cycle;
		buck-enable;
		buck-power-sequencing;
		delay-compensation;
		status = "okay";
	};
};

#include <dts-bindings/adc/stm32g4xx.h>
&adc1 {
	currsmp: currsmp {
		status = "okay";
		compatible = "st,stm32-currsmp-shunt";
		pinctrl-0 = <&adc1_in1_pa0 &adc1_in2_pa1 &adc1_in3_pa2>;
		pinctrl-names = "default";
		adc-resolution = <12>;
		adc-tsample = <13>;
		adc-oversampling = <2>;
		adc-channels = <3 2 1>;
		adc-trigger = <STM32_ADC12_INJ_TRIG_TIM1_TRGO>;
		csa-gain-mv-per-a = <1200>;
		filter-cutoff-hz = <1000>;
	};
};

&timers1 {
	status = "okay";

	svpwm: svpwm {
		status = "okay";
		compatible = "st,stm32-svpwm";
		currsmp = <&currsmp>;
		drv8316 = <&drv8316>;
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pa9 &tim1_ch3_pa10 &tim1_ch1n_pb13 &tim1_ch2n_pb14 &tim1_ch3n_pb15 &tim1_bkin2_pa11>;
		pinctrl-names = "default";
		driver {
			compatible = "ti,drv8316c";
			enable-comp-outputs;
		};
	};
};

&vref {
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};
