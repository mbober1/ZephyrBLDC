{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32G431CB",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "jlink",
      "serverpath": "/opt/SEGGER/JLink/JLinkGDBServerCLExe",
      "armToolchainPath": "${env:ZEPHYR_SDK}/gnu/arm-zephyr-eabi/bin",
      "toolchainPrefix": "arm-zephyr-eabi",
      "interface": "swd",
      "device": "STM32G431CB",
      "svdFile": "STM32G431xx.svd",
      "preLaunchTask": "Build MicroSpora",
      "runToEntryPoint": "main"
    },
    {
      "name": "Debug native_sim",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/zephyr/zephyr.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Build native"
    },
  ]
}
